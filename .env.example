# Valores ficticios. Copiar a .env y sustituirlos antes de arrancar servicios.
# No usar estas credenciales fuera del entorno local de desarrollo.
# .env no se versiona. Este archivo sí.

# --- PostgreSQL: rol administrador (Docker, migraciones y mantenimiento) ---
# El contenedor solo recibe POSTGRES_USER, POSTGRES_PASSWORD y POSTGRES_DB.
# Puerto del host de esta versión: 5434. Dentro del contenedor PostgreSQL escucha en 5432.
# docker-compose.yml fija la base rag_chatbot y el puerto publicado 5434; no los toma de aquí.
# La aplicación sí lee POSTGRES_DB, POSTGRES_PORT, APP_DB_NAME y APP_DB_PORT: deben coincidir.
POSTGRES_USER=rag_admin
POSTGRES_PASSWORD=change-me-admin-password
POSTGRES_DB=rag_chatbot
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434

# --- Conexión común de los roles de empresa ---
APP_DB_NAME=rag_chatbot
APP_DB_HOST=127.0.0.1
APP_DB_PORT=5434

# --- Empresa 1: Hornos Alba ---
RAG_EMPRESA_1_USER=rag_empresa_1
RAG_EMPRESA_1_PASSWORD=TU_CONTRASEÑA_1
RAG_EMPRESA_1_ID=1
RAG_EMPRESA_1_NAME="Hornos Alba"

# --- Empresa 2: Clínica Sonrisa ---
RAG_EMPRESA_2_USER=rag_empresa_2
RAG_EMPRESA_2_PASSWORD=TU_CONTRASEÑA_2
RAG_EMPRESA_2_ID=2
RAG_EMPRESA_2_NAME="Clínica Sonrisa"

# --- Empresa 3: Ruta Norte ---
RAG_EMPRESA_3_USER=rag_empresa_3
RAG_EMPRESA_3_PASSWORD=TU_CONTRASEÑA_3
RAG_EMPRESA_3_ID=3
RAG_EMPRESA_3_NAME="Ruta Norte"

# --- Vertex AI para src/rag.py. Autenticación ADC; no incluir claves aquí. ---
# Usar un proyecto propio autorizado. No copiar identificadores ajenos ni claves.
# src/rag.py lee VERTEX_PROJECT, VERTEX_LOCATION y VERTEX_MODEL. No lee una API key.
VERTEX_PROJECT=tu-proyecto-vertex
VERTEX_LOCATION=us
VERTEX_MODEL=gemini-3.1-flash-lite
