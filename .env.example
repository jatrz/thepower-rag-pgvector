# Valores ficticios. Copiar a .env y sustituirlos antes de arrancar servicios.
# No usar estas credenciales fuera del entorno local de desarrollo.

# --- PostgreSQL: rol administrador (Docker, migraciones y mantenimiento) ---
POSTGRES_USER=rag_admin
POSTGRES_PASSWORD=change-me-admin-password
POSTGRES_DB=thepower_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- PostgreSQL: rol de aplicación (runtime, sujeto a RLS) ---
APP_DB_USER=rag_app
APP_DB_PASSWORD=change-me-app-password
APP_DB_NAME=thepower_rag
APP_DB_HOST=localhost
APP_DB_PORT=5432

# --- Embeddings locales ---
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384

# --- Google Gen AI / Gemini ---
GOOGLE_API_KEY=replace-with-a-fake-or-local-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Aplicación ---
APP_ENV=development
LOG_LEVEL=INFO
